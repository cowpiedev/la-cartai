# =============================================================================
# La Carta IA — Variables de entorno
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA commitees .env.local al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# Obtén estos valores en: https://supabase.com/dashboard → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Service role key (solo en servidor, NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>

# -----------------------------------------------------------------------------
# Base de datos (Prisma)
# Obtén la URL en: Supabase → Settings → Database → Connection string (URI)
# Usa el modo "Transaction" (puerto 6543) para DATABASE_URL con pgBouncer
# Usa el modo "Session" (puerto 5432) para DIRECT_URL sin pooler
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# OpenAI (módulo IA de precios — plan premium)
# Obtén tu clave en: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Google Maps API (negocios cercanos)
# Activa las APIs: Places API, Maps JavaScript API
# https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=AIza...

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="La Carta IA"
